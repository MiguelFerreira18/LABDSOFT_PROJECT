    "@capacitor/core": "6.1.2",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/geolocation": "^6.0.2",
    "@capacitor/google-maps": "^6.0.1",
    "@capacitor/haptics": "6.0.1",
    "@capacitor/ios": "6.1.2",
    "@capacitor/keyboard": "6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/status-bar": "6.0.1",
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-vue": "^2.2.0",
    "@ionic/core": "^8.4.1",
    "@ionic/vue": "^8.4.1",
    "@google/generative-ai": "^0.21.0",
    "@ionic/vue-router": "^8.0.0",
    "@types/qrcode": "^1.5.5",
    "axios": "^1.7.7",
    "dotenv": "^16.4.7",
    "ionicons": "^7.0.0",
    "openai": "^4.77.0",
    "public": "file:",
    "qrcode": "^1.5.4",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.1.2",
