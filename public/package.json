{
  "name": "public",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:error": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "test:unitEvents": "jest",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,vue}\"",
    "prepare": "husky install && cd .. && husky public/.husky",
    "lint": "eslint .",
    "build:run": "go run ./scripts/decide_ide.go npm run build && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
